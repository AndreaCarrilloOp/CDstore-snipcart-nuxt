# Clave pública TEST de Snipcart. Nunca usar claves secretas.
NUXT_PUBLIC_SNIPCART_API_KEY=
NUXT_PUBLIC_SNIPCART_CURRENCY=usd
NUXT_PUBLIC_SNIPCART_LANGUAGE=es
# GitHub público con Issues habilitados y Utterances autorizado
NUXT_PUBLIC_UTTERANCES_REPO=AndreaCarrilloOp/comentarios_utterances
# En Netlify usar la URL publicada, sin barra final
NUXT_PUBLIC_SITE_URL=http://localhost:3000
